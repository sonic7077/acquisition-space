# 获客空间公开配置模板（请复制为 .env 后再按实际环境修改）
# 注意：
# 1. .env 已被 .gitignore 忽略，严禁把包含真实密码/Token/内网地址的 .env 提交到 Git。
# 2. 业务类敏感凭证（AI 模型 Key、TikHub Key、飞书 App Secret、公众号 Secret、企微 Webhook、
#    同机小V猫 MCP Token 等）统一在 Web「系统设置」中配置并加密保存于 .data/system.db（主密钥 .data/master.key）。

# 运行时数据目录（保存 SQLite system.db、master.key、上传媒体 assets/ 与运行日志）
ACQUISITION_DATA_DIR=.data

# 服务端监听端口
ACQUISITION_PORT=8787

# HTTPS 反向代理部署时设为 1，仅允许通过 HTTPS 下发会话 Cookie；纯本机 HTTP 访问保持 0
SECURE_COOKIE=0

# 可选：默认飞书多维表格 / 知识空间模板链接（为空时首次启动由管理员在 Web「系统设置 -> 飞书」填写）
# 示例：FEISHU_DEFAULT_URL=https://<your-tenant>.feishu.cn/wiki/<node_token>
FEISHU_DEFAULT_URL=

# 可选：限制允许填入的飞书企业域名白名单（逗号分隔；留空则允许标准 *.feishu.cn 与 *.larkoffice.com HTTPS 链接）
# 示例：FEISHU_ALLOWED_HOSTS=<your-tenant>.feishu.cn
FEISHU_ALLOWED_HOSTS=

# 可选：小V猫同机直连（server_direct）环境覆盖参数
# 服务端如与小V猫同机部署，Token 建议直接在 Web「系统设置 -> 发布执行器」加密保存，此处默认留空
VCAT_MCP_URL=http://127.0.0.1:3199/mcp
VCAT_MCP_TOKEN=
# 小V猫写工具全局最小调用间隔（秒）；生产建议保持 3.2，测试环境可设 0
VCAT_MCP_MIN_INTERVAL=3.2
