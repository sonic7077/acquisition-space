# 渠道推广器执行代理独立配置模板（请复制为 executor/vcat_agent.env 后按需填写，严禁提交真实凭据）
# 适用于：
# - 模式二（Web 前端 + 本机代理 client_local）：在操作者电脑启动，连接获客空间服务器与本机 127.0.0.1:3199/mcp
# - 模式一 B（服务器托管执行机 server_managed）：在独立桌面执行机启动

# 获客空间 Web 服务地址（请替换为实际服务端地址）
VCAT_SERVER_URL=https://<your-acquisition-space-host>

# 运行模式：client_local（操作者电脑本机）或 server_managed（服务端独立桌面执行机）
VCAT_AGENT_MODE=client_local

# 本机渠道推广器本地服务地址（默认仅监听回环地址 127.0.0.1:3199）
VCAT_MCP_URL=http://127.0.0.1:3199/mcp

# 本机渠道推广器开启本地服务后生成的访问令牌（请勿写入代码仓库）
VCAT_MCP_TOKEN=<your-local-promoter-token>

# 节点展示名称（首次配对时注册到服务端，如「家里迷你主机」「办公室Win11」）
VCAT_NODE_NAME=桌面渠道推广器节点

# HTTP 长轮询挂起秒数（默认 25，降低实时交互等待；设 0 可退回短轮询）
VCAT_POLL_WAIT=25

# 代理状态与资产 SHA-256 缓存目录（保存配对后的永久节点凭据，请妥善保管）
VCAT_STATE_DIR=~/.acquisition-vcat-agent
